# ---------------------------------------------------------------------------
# Iran Tech Job Intelligence - environment. Copy to .env and fill the values.
# Never commit .env. Generate secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------

# Public URL users open (HTTPS). Used for e-mail links, Telegram links, CSRF origin check.
PUBLIC_BASE_URL=https://localhost:8443
HTTPS_PORT=8443
HTTP_PORT=8088

# PostgreSQL
POSTGRES_USER=jobintel
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=jobintel

# JWT signing key (>= 32 chars) and Fernet key for secrets stored in the DB
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE_ME_at_least_32_random_characters
ENCRYPTION_KEY=

# First admin (created on first start only; change the password after login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
ALLOW_REGISTRATION=true

# Collector (the default interval is 4h; each source also has its own minimum)
COLLECT_INTERVAL_MINUTES=240
COLLECTOR_REQUEST_DELAY_SECONDS=2.5
COLLECTOR_MAX_PAGES_PER_RUN=250
COLLECTOR_USER_AGENT="IranTechJobIntelligenceBot/1.0 (+job market research; contact: admin@example.com)"
# Optional outbound proxy for the collector, e.g. http://proxy:3128
COLLECTOR_PROXY=

# AI - can also be set from Settings > AI in the web UI (the UI value wins).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# SMTP - can also be set from Settings > Email (the UI value wins).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# Telegram - create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling (no public URL needed) | webhook (needs a public HTTPS PUBLIC_BASE_URL)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# Optional proxy for api.telegram.org, e.g. socks5://host:1080 or http://host:3128
TELEGRAM_PROXY=

DAILY_DIGEST_HOUR=8
TIMEZONE=Asia/Tehran
API_WORKERS=2
